				},
				{
					"name": "QR usado dos veces (replay attack)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generar QR fresco para probar replay",
									"pm.sendRequest({",
									"    url: pm.collectionVariables.get('base_url') + '/qr/generate',",
									"    method: 'GET',",
									"    header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('student_token') }",
									"}, function (err, res) {",
									"    var json = res.json();",
									"    pm.collectionVariables.set('_replay_qr', json.token);",
									"    // Primer uso del QR",
									"    pm.sendRequest({",
									"        url: pm.collectionVariables.get('base_url') + '/access/scan',",
									"        method: 'POST',",
									"        header: { 'Content-Type': 'application/json' },",
									"        body: {",
									"            mode: 'raw',",
									"            raw: JSON.stringify({ token: json.token, device_id: parseInt(pm.collectionVariables.get('device_id')) })",
									"        }",
									"    });",
									"});"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status 400 - QR reusado\", () => pm.response.to.have.status(400));"
								]
							}
						}
					],
