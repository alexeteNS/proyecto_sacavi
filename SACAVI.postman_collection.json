{
	"info": {
		"name": "SACAVI API",
		"description": "Colección completa de pruebas para SACAVI - Sistema de Control de Acceso Vehicular Universitario\n\nIncluye flujo positivo, casos negativos y simulación ESP32.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:3000" },
		{ "key": "student_token", "value": "" },
		{ "key": "admin_token", "value": "" },
		{ "key": "qr_token", "value": "" },
		{ "key": "device_key", "value": "" },
		{ "key": "device_id", "value": "" },
		{ "key": "vehicle_id", "value": "" },
		{ "key": "student_id", "value": "" }
	],
	"item": [
		{
			"name": "01 Device Setup",
			"item": [
				{
					"name": "Registrar ESP32 (Entrada Norte)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"var json = pm.response.json();",
									"pm.test(\"Devuelve device_key\", () => {",
									"    pm.expect(json).to.have.property('device_key');",
									"    pm.expect(json).to.have.property('id_device');",
									"});",
									"pm.collectionVariables.set('device_key', json.device_key);",
									"pm.collectionVariables.set('device_id', json.id_device);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Entrada Principal\",\n    \"location\": \"Puerta Norte\",\n    \"device_key\": \"ESP32-A8292-001\"\n}"
						},
						"url": { "raw": "{{base_url}}/device/register", "host": ["{{base_url}}"], "path": ["device", "register"] }
					}
				},
				{
					"name": "Registrar ESP32 (Entrada Sur)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Entrada Secundaria\",\n    \"location\": \"Puerta Sur\",\n    \"device_key\": \"ESP32-B394-002\"\n}"
						},
						"url": { "raw": "{{base_url}}/device/register", "host": ["{{base_url}}"], "path": ["device", "register"] }
					}
				},
				{
					"name": "Consultar estado ESP32",
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/device/status/{{device_key}}", "host": ["{{base_url}}"], "path": ["device", "status", "{{device_key}}"] }
					}
				}
			]
		},
		{
			"name": "02 Auth - Estudiante",
			"item": [
				{
					"name": "Registrar estudiante",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"var json = pm.response.json();",
									"pm.test(\"Rol ESTUDIANTE\", () => {",
									"    pm.expect(json.role).to.eql('ESTUDIANTE');",
									"    pm.expect(json.permissions).to.include('REGISTRAR_VEHICULO');",
									"});",
									"pm.collectionVariables.set('student_id', json.id_user);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"María García\",\n    \"email\": \"maria@universidad.edu\",\n    \"password\": \"estudiante123\"\n}"
						},
						"url": { "raw": "{{base_url}}/user/register", "host": ["{{base_url}}"], "path": ["user", "register"] }
					}
				},
				{
					"name": "Login estudiante",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"var json = pm.response.json();",
									"pm.test(\"Token + user\", () => {",
									"    pm.expect(json).to.have.property('token');",
									"    pm.expect(json.user.role).to.eql('ESTUDIANTE');",
									"});",
									"pm.collectionVariables.set('student_token', json.token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"maria@universidad.edu\",\n    \"password\": \"estudiante123\"\n}"
						},
						"url": { "raw": "{{base_url}}/user/login", "host": ["{{base_url}}"], "path": ["user", "login"] }
					}
				},
				{
					"name": "Perfil estudiante",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"var json = pm.response.json();",
									"pm.test(\"Permisos correctos\", () => {",
									"    pm.expect(json.role).to.eql('ESTUDIANTE');",
									"    pm.expect(json.permissions).to.include('REGISTRAR_VEHICULO');",
									"    pm.expect(json.permissions).to.not.include('ABRIR_PLUMA');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }],
						"url": { "raw": "{{base_url}}/user/profile", "host": ["{{base_url}}"], "path": ["user", "profile"] }
					}
				}
			]
		},
