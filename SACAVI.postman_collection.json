								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }],
						"url": { "raw": "{{base_url}}/qr/generate", "host": ["{{base_url}}"], "path": ["qr", "generate"] }
					}
				},
				{
					"name": "ESP32 escanea QR (entrada)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
									"var json = pm.response.json();",
									"pm.test(\"Acceso permitido\", () => {",
